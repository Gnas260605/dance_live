{
  "name": "roblox-tiktok-autodance-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for TikTok Live to Roblox auto dance SaaS platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:api": "npm start --workspace=apps/api",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "test-comment": "npm run test-comment --workspace=apps/api"
  }
}
