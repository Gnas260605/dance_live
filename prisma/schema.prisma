// schema.prisma
// Production Relational Database Schema for TikTok Live Roblox SaaS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREATOR
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(CREATOR)
  planTier     PlanTier       @default(PRO)
  apiKey       String         @unique @default(uuid())
  apiSecret    String         @default(uuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  streamConfig  StreamConfig?
  musicTracks   MusicTrack[]
  danceEmotes   DanceAnimation[]
  sessions      StreamSession[]
  eventMappings EventMapping[]
  actionDefs    ActionDefinition[]
  robloxSession RobloxSession?
}

model StreamConfig {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiktokUsername  String   @default("sandg.music")
  activeTheme     String   @default("PHONK")
  currentMusicId  String   @default("")
  selectedDanceId String   @default("rbxassetid://507771019")
  overlayTitle    String   @default("🎵 S&G MUSIC - ROBLOX TIKTOK DANCE LIVE 🎵")
  overlayColor    String   @default("#ff007f")
  maxQueueSize    Int      @default(10)
  danceDuration   Int      @default(12)
  isLive          Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model MusicTrack {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  soundId   String
  genre     String   @default("PHONK")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DanceAnimation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  animationId String
  genre       String   @default("PHONK")
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model StreamSession {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiktokUsername      String
  startedAt           DateTime    @default(now())
  endedAt             DateTime?
  totalComments       Int         @default(0)
  totalGifts          Int         @default(0)
  totalDancersSpawned Int         @default(0)
  logs                StreamLog[]
}

model StreamLog {
  id        String        @id @default(uuid())
  sessionId String
  session   StreamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  level     String        @default("INFO")
  message   String
  timestamp DateTime      @default(now())
}

model EventMapping {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  description             String?
  enabled                 Boolean  @default(true)
  priority                Int      @default(10)
  triggerType             String   @default("TIKTOK_GIFT")
  giftId                  String?
  giftName                String?
  minRepeatCount          Int      @default(1)
  minTotalCoins           Int      @default(0)
  actionsJson             String   @default("[]")
  cooldownMs              Int      @default(500)
  userCooldownMs          Int      @default(0)
  queueMode               String   @default("QUEUE")
  stopProcessingAfterMatch Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ActionDefinition {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  type              String
  enabled           Boolean  @default(true)
  defaultDelayMs    Int      @default(0)
  defaultDurationMs Int      @default(5000)
  parametersJson    String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GameEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique @default(uuid())
  userId           String
  mappingId        String?
  eventType        String    @default("gift_effect")
  actionsJson      String
  contextJson      String
  status           String    @default("QUEUED")
  deliveryAttempts Int       @default(0)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  ackedAt          DateTime?
}

model RobloxSession {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId       String?
  jobId         String?
  scriptVer     String   @default("1.0.0")
  lastHeartbeat DateTime @default(now())
  isOnline      Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}
