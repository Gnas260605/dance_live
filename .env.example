# PORT configuration for the Express server
PORT=3001

# Database URL for PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dance_live?schema=public"

# JWT secret key for dashboard authentication
JWT_SECRET="your_jwt_secret_key_here"

# TikTok EulerStream API key (Required for signature connection on hosted servers like Render)
# Generate a free community key at https://www.eulerstream.com
EULERSTREAM_API_KEY=""
